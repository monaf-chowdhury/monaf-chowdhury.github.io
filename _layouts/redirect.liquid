{% comment %}
  Minimal redirect for a page that moved. Front matter: permalink (the old URL), redirect_to (the new path).
{% endcomment %}
{%- assign target = page.redirect_to | relative_url -%}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Moved: {{ page.title }}</title>
    <link rel="canonical" href="{{ page.redirect_to | absolute_url }}">
    <meta name="robots" content="noindex">
    <meta http-equiv="refresh" content="0; url={{ target }}">
    <script>
      location.replace("{{ target }}" + location.hash);
    </script>
  </head>
  <body>
    <p>This page has moved to <a href="{{ target }}">{{ page.title }}</a>.</p>
  </body>
</html>
