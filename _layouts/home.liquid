---
layout: default
---
{% comment %}
  Homepage, Swiss style: a 12-column grid with section names in the left three columns.
  The intro prose is the page content; everything else comes from front matter:
  kicker, tagline, status, profile.image, links[{label, icon, url}],
  research{lead, threads[{title, text, projects[{label, url}]}]},
  phd{kicker, title, text, directions_title, directions[{title, text}], actions[{label, url, primary}]},
  featured[] (project file names in _projects; title, authors, venue, thumbnail and links are read from each page),
  announcements, visitor_map.
{% endcomment %}
<div class="hp">
  <header class="hp-hero">
    {% if page.profile.image %}
      <div class="hp-photo">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {%
          include figure.liquid loading="eager" path=profile_image_path sizes="(min-width: 768px) 240px, 62vw" alt=page.profile.alt
          cache_bust=true
        %}
      </div>
    {% endif %}

    <div class="hp-id">
      {% if page.kicker %}<p class="hp-kicker">{{ page.kicker }}</p>{% endif %}
      <h1 class="hp-name">
        <span>{{ site.first_name }} {{ site.middle_name }}</span>
        <span>{{ site.last_name }}</span>
      </h1>
      {% if page.status %}
        <a class="hp-status" href="#phd"><span class="hp-square" aria-hidden="true"></span>{{ page.status }}</a>
      {% endif %}
      {% if page.links %}
        <ul class="hp-social">
          {% for l in page.links %}
            <li>
              <a href="{{ l.url | relative_url }}"{% if l.url contains '://' %} target="_blank" rel="noopener noreferrer"{% endif %}>
                {% if l.icon %}<i class="{{ l.icon }}" aria-hidden="true"></i>{% endif %}<span>{{ l.label }}</span>
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>

    {% if page.tagline %}<p class="hp-tagline">{{ page.tagline | markdownify | remove: '<p>' | remove: '</p>' | strip }}</p>{% endif %}
    <div class="hp-intro hp-prose">{{ content }}</div>
  </header>

  {% if page.research %}
    <section class="hp-sec" id="research" aria-labelledby="research-title">
      <div class="hp-sec-head"><h2 id="research-title">{{ page.research.title | default: 'Research' }}</h2></div>
      <div class="hp-sec-body">
        {% if page.research.lead %}<div class="hp-lead hp-prose">{{ page.research.lead | markdownify }}</div>{% endif %}
        <div class="hp-threads">
          {% for t in page.research.threads %}
            <article class="hp-thread">
              <h3>{{ t.title }}</h3>
              <p>{{ t.text }}</p>
              {% if t.projects %}
                <p class="hp-arrows">
                  {% for p in t.projects %}<a href="{{ p.url | relative_url }}">{{ p.label }}</a>{% endfor %}
                </p>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if page.phd %}
    <section class="hp-sec hp-phd" id="phd" aria-labelledby="phd-title">
      <div class="hp-sec-head">
        <h2 id="phd-title">PhD</h2>
        {% if page.phd.kicker %}<p>{{ page.phd.kicker }}</p>{% endif %}
      </div>
      <div class="hp-sec-body">
        <h3 class="hp-phd-title">{{ page.phd.title }}</h3>
        <div class="hp-phd-text hp-prose">{{ page.phd.text | markdownify }}</div>
        {% if page.phd.directions %}
          <p class="hp-label">{{ page.phd.directions_title | default: 'What I want to work on' }}</p>
          <dl class="hp-dirs">
            {% for d in page.phd.directions %}
              <div>
                <dt>{{ d.title }}</dt>
                <dd>{{ d.text }}</dd>
              </div>
            {% endfor %}
          </dl>
        {% endif %}
        {% if page.phd.actions %}
          <p class="hp-actions">
            {% for a in page.phd.actions %}
              <a class="hp-btn{% if a.primary %} is-primary{% endif %}" href="{{ a.url | relative_url }}"{% if a.url contains '://' %} target="_blank" rel="noopener noreferrer"{% endif %}>
                {{- a.label -}}
              </a>
            {% endfor %}
          </p>
        {% endif %}
      </div>
    </section>
  {% endif %}

  {% if page.announcements and page.announcements.enabled and site.news != blank %}
    <section class="hp-sec" id="news" aria-labelledby="news-title">
      <div class="hp-sec-head"><h2 id="news-title">News</h2></div>
      <div class="hp-sec-body">
        {% assign news = site.news | reverse %}
        {% assign news_limit = page.announcements.limit | default: news.size %}
        <div class="hp-news{% if page.announcements.scrollable %} is-scrollable{% endif %}" tabindex="0" role="region" aria-label="News, scrollable">
          <ol>
            {% for item in news limit: news_limit %}
              <li>
                <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %Y' }}</time>
                <div class="hp-prose">
                  {% if item.inline %}
                    {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                  {% else %}
                    <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
                  {% endif %}
                </div>
              </li>
            {% endfor %}
          </ol>
        </div>
        <a class="hp-more" href="{{ '/news/' | relative_url }}">All news →</a>
      </div>
    </section>
  {% endif %}

  {% if page.featured %}
    <section class="hp-sec hp-pubs-sec" id="publications" aria-labelledby="pubs-title">
      <div class="hp-sec-head"><h2 id="pubs-title">Selected publications</h2></div>
      <div class="hp-sec-body">
        <ol class="hp-pubs">
          {% for slug in page.featured %}
            {% assign p = site.projects | where: 'slug', slug | first %}
            {% if p %}
              {% assign p_url = p.url | relative_url %}
              <li class="hp-pub">
                {% if p.img %}
                  <a class="hp-thumb" href="{{ p_url }}" tabindex="-1" aria-hidden="true">
                    {% include figure.liquid loading="lazy" path=p.img sizes="(min-width: 768px) 240px, 90vw" alt="" %}
                  </a>
                {% endif %}
                <div class="hp-pub-body">
                  <p class="hp-venue">
                    {{ p.venue | default: p.eyebrow[0] }}
                    {% if p.status %}<span>· {{ p.status }}</span>{% endif %}
                  </p>
                  <h3 class="hp-pub-title"><a href="{{ p_url }}">{{ p.paper_title | default: p.title }}</a></h3>
                  {% if p.authors %}
                    <p class="hp-authors">
                      {% for a in p.authors -%}
                        <span{% if a.me %} class="is-me"{% endif %}>{{ a.name }}</span>{% unless forloop.last %}, {% endunless %}
                      {%- endfor %}
                    </p>
                  {% endif %}
                  {% if p.description %}<p class="hp-tldr">{{ p.description }}</p>{% endif %}
                  <p class="hp-arrows">
                    <a href="{{ p_url }}">Project</a>
                    {% assign soon = '' | split: '' %}
                    {% for l in p.links %}
                      {% if l.ghost %}{% continue %}{% endif %}
                      {% if l.soon or l.url == nil %}
                        {% unless l.label == 'arXiv' %}{% assign soon = soon | push: l.label %}{% endunless %}
                      {% else %}
                        <a href="{{ l.url }}" target="_blank" rel="noopener noreferrer">{{ l.label }}</a>
                      {% endif %}
                    {% endfor %}
                    {% if soon.size > 0 %}<span class="is-soon">{{ soon | join: ' & ' | capitalize | replace: '&', '&amp;' }} soon</span>{% endif %}
                  </p>
                </div>
              </li>
            {% endif %}
          {% endfor %}
        </ol>
        <a class="hp-more" href="{{ '/publications/' | relative_url }}">All publications →</a>
      </div>
    </section>
  {% endif %}

  {% include visitor_map.liquid %}
</div>
