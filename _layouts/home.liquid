---
layout: default
---
{% comment %}
  Homepage. The intro prose is the page content; everything else comes from front matter:
  kicker, tagline, status, profile.image, links[{label, icon, url}],
  research{lead, threads[{title, text, tone, projects[{label, url}]}]},
  phd{kicker, title, text, directions[{title, text}], actions[{label, url, icon, primary}]},
  featured[] (project file names in _projects; title, authors, venue and links are read from each page),
  announcements, visitor_map.
{% endcomment %}
<div class="hp">
  <header class="hp-hero">
    <div class="hp-hero-head">
      {% if page.kicker %}<p class="hp-kicker">{{ page.kicker }}</p>{% endif %}
      <h1 class="hp-name">{{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}</h1>
      {% if page.tagline %}<p class="hp-tagline">{{ page.tagline | markdownify | remove: '<p>' | remove: '</p>' | strip }}</p>{% endif %}
      {% if page.status %}
        <a class="hp-status" href="#phd"><span class="hp-dot" aria-hidden="true"></span>{{ page.status }}</a>
      {% endif %}
    </div>

    <div class="hp-side">
      {% if page.profile.image %}
        <div class="hp-portrait">
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class="hp-photo" sizes="(min-width: 930px) 290px, (min-width: 768px) 30vw, 280px"
            alt=page.profile.alt cache_bust=true
          %}
        </div>
      {% endif %}
      {% if page.links %}
        <ul class="hp-links">
          {% for l in page.links %}
            <li>
              <a href="{{ l.url | relative_url }}"{% if l.url contains '://' %} target="_blank" rel="noopener noreferrer"{% endif %}>
                <i class="{{ l.icon }}" aria-hidden="true"></i>{{ l.label }}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>

    <div class="hp-hero-body">
      <div class="hp-intro hp-prose">{{ content }}</div>
    </div>
  </header>

  {% if page.research %}
    <section class="hp-section" id="research" aria-labelledby="research-title">
      <div class="hp-head"><h2 id="research-title">{{ page.research.title | default: 'Research' }}</h2></div>
      {% if page.research.lead %}<div class="hp-lead hp-prose">{{ page.research.lead | markdownify }}</div>{% endif %}
      <div class="hp-threads">
        {% for t in page.research.threads %}
          <article class="hp-thread hp-tone-{{ t.tone | default: 'sky' }}">
            <span class="hp-thread-n">0{{ forloop.index }}</span>
            <h3>{{ t.title }}</h3>
            <p>{{ t.text }}</p>
            {% if t.projects %}
              <p class="hp-thread-links">
                {% for p in t.projects %}<a href="{{ p.url | relative_url }}">{{ p.label }}<span aria-hidden="true"> →</span></a>{% endfor %}
              </p>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% if page.phd %}
    <section class="hp-section hp-phd" id="phd" aria-labelledby="phd-title">
      <div class="hp-phd-card">
        <div class="hp-phd-main">
          {% if page.phd.kicker %}<p class="hp-kicker hp-kicker-status"><span class="hp-dot" aria-hidden="true"></span>{{ page.phd.kicker }}</p>{% endif %}
          <h2 id="phd-title">{{ page.phd.title }}</h2>
          <div class="hp-prose">{{ page.phd.text | markdownify }}</div>
          {% if page.phd.actions %}
            <div class="hp-actions">
              {% for a in page.phd.actions %}
                <a class="hp-btn{% if a.primary %} is-primary{% endif %}" href="{{ a.url | relative_url }}"{% if a.url contains '://' %} target="_blank" rel="noopener noreferrer"{% endif %}>
                  {% if a.icon %}<i class="{{ a.icon }}" aria-hidden="true"></i>{% endif %}{{ a.label }}
                </a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
        {% if page.phd.directions %}
          <aside class="hp-phd-side">
            <p class="hp-side-title">{{ page.phd.directions_title | default: 'What I want to work on' }}</p>
            <ol>
              {% for d in page.phd.directions %}
                <li><strong>{{ d.title }}</strong><span>{{ d.text }}</span></li>
              {% endfor %}
            </ol>
          </aside>
        {% endif %}
      </div>
    </section>
  {% endif %}

  {% if page.announcements and page.announcements.enabled and site.news != blank %}
    <section class="hp-section" id="news" aria-labelledby="news-title">
      <div class="hp-head">
        <h2 id="news-title">News</h2>
        <a class="hp-more" href="{{ '/news/' | relative_url }}">All news →</a>
      </div>
      {% assign news = site.news | reverse %}
      {% assign news_limit = page.announcements.limit | default: news.size %}
      <div class="hp-news{% if page.announcements.scrollable %} is-scrollable{% endif %}" tabindex="0" role="region" aria-label="News, scrollable">
        <ol class="hp-news-list">
          {% for item in news limit: news_limit %}
            <li>
              <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %Y' }}</time>
              <div class="hp-prose">
                {% if item.inline %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% else %}
                  <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% endif %}
              </div>
            </li>
          {% endfor %}
        </ol>
      </div>
    </section>
  {% endif %}

  {% if page.featured %}
    <section class="hp-section" id="publications" aria-labelledby="pubs-title">
      <div class="hp-head">
        <h2 id="pubs-title">Selected publications</h2>
        <a class="hp-more" href="{{ '/publications/' | relative_url }}">All publications →</a>
      </div>
      <div class="hp-pubs">
        {% for slug in page.featured %}
          {% assign p = site.projects | where: 'slug', slug | first %}
          {% if p %}
            {% assign p_url = p.url | relative_url %}
            <article class="hp-pub hp-tone-{{ p.theme | default: 'sky' }}">
              {% if p.img %}
                <a class="hp-pub-thumb" href="{{ p_url }}" tabindex="-1" aria-hidden="true">
                  {% include figure.liquid loading="lazy" path=p.img sizes="(min-width: 768px) 220px, 90vw" alt="" %}
                </a>
              {% endif %}
              <div class="hp-pub-body">
                <p class="hp-pub-venue">
                  <span>{{ p.venue | default: p.eyebrow[0] }}</span>
                  {% if p.status %}<em>{{ p.status }}</em>{% endif %}
                </p>
                <h3 class="hp-pub-title"><a href="{{ p_url }}">{{ p.paper_title | default: p.title }}</a></h3>
                {% if p.authors %}
                  <p class="hp-pub-authors">
                    {% for a in p.authors -%}
                      <span{% if a.me %} class="is-me"{% endif %}>{{ a.name }}</span>{% unless forloop.last %}, {% endunless %}
                    {%- endfor %}
                  </p>
                {% endif %}
                {% if p.description %}<p class="hp-pub-tldr">{{ p.description }}</p>{% endif %}
                <p class="hp-pub-links">
                  <a class="is-primary" href="{{ p_url }}">Project page<span aria-hidden="true"> →</span></a>
                  {% assign soon = '' | split: '' %}
                  {% for l in p.links %}
                    {% if l.ghost %}{% continue %}{% endif %}
                    {% if l.soon or l.url == nil %}
                      {% unless l.label == 'arXiv' %}{% assign soon = soon | push: l.label %}{% endunless %}
                    {% else %}
                      <a href="{{ l.url }}" target="_blank" rel="noopener noreferrer">
                        {% if l.icon %}<i class="{{ l.icon }}" aria-hidden="true"></i>{% endif %}{{ l.label }}
                      </a>
                    {% endif %}
                  {% endfor %}
                  {% if soon.size > 0 %}<span class="is-soon">{{ soon | join: ' & ' | capitalize | replace: '&', '&amp;' }} soon</span>{% endif %}
                </p>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% include visitor_map.liquid %}
</div>
